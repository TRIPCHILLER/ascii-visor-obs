uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d atlas;
uniform texture2d levels;
uniform texture2d previous_levels;
uniform float stability;
uniform float history_valid;
uniform float2 grid_size;
uniform float glyph_count;
uniform float shape_mode;
uniform float2 output_size;
uniform float contrast;
uniform float gamma;
uniform float black_point;
uniform float white_point;
uniform float invert;
uniform float mirror;
uniform float transparent;
uniform float4 foreground;
uniform float4 background;
uniform float zoom;
uniform float2 center;
sampler_state linear_sampler { Filter = Linear; AddressU = Clamp; AddressV = Clamp; };
sampler_state point_sampler { Filter = Point; AddressU = Clamp; AddressV = Clamp; };
struct VertData { float4 pos : POSITION; float2 uv : TEXCOORD0; };
VertData VSDefault(VertData v) { v.pos=mul(float4(v.pos.xyz,1.0),ViewProj); return v; }
float4 PSDownsample(VertData v) : TARGET {
 float2 cell=floor(v.uv*grid_size);
 float4 sum=float4(0.0,0.0,0.0,0.0);
 // Area sampling replaces browser Canvas downscaling. No CPU frame readback.
 for(int y=0;y<4;y++)for(int x=0;x<4;x++) {
  float2 uv=(cell+(float2(x,y)+0.5)/4.0)/grid_size;
  if(mirror>0.5) uv.x=1.0-uv.x;
  sum+=image.Sample(linear_sampler,uv);
 }
 return sum/16.0;
}
float4 PSQuantize(VertData v) : TARGET {
 float4 src=image.Sample(point_sampler,v.uv);
 float q=dot(src.rgb,float3(0.2126,0.7152,0.0722));
 q=saturate((q-0.5)*contrast+0.5);
 q=pow(q,1.0/gamma);
 q=saturate((q-black_point)/max(0.000001,white_point-black_point));
 if(invert>0.5)q=1.0-q;
 float scale=max(1.0,glyph_count-1.0);
 float u=q*(glyph_count-1.0);
 float idx=floor(u+0.5);
 if(stability>0.5 && history_valid>0.5){
  float previous=floor(previous_levels.Sample(point_sampler,v.uv).r*scale+0.5);
  if(abs(u-previous)<=0.75)idx=previous;
 }
 return float4(idx/scale,0.0,0.0,1.0);
}
float4 PSDraw(VertData v) : TARGET {
 float2 frame_pixel=floor(v.uv*output_size+0.0001);
 v.uv=(v.uv-0.5)/zoom+center;
 if(v.uv.x<0.0 || v.uv.x>1.0 || v.uv.y<0.0 || v.uv.y>1.0){return transparent>0.5?float4(0.0,0.0,0.0,0.0):background;}
 float2 cell=min(floor(v.uv*grid_size),grid_size-1.0);
 float2 uv=(cell+0.5)/grid_size;
 float4 src=image.Sample(point_sampler,uv);
 float idx=floor(levels.Sample(point_sampler,uv).r*max(1.0,glyph_count-1.0)+0.5);
 float2 local=frac(v.uv*grid_size);
 float mask;
 if(shape_mode>0.5){
  // Six tones: empty, then five filled sizes with equal coverage increments.
  // Match circle and square areas so switching sets preserves tonal balance.
  float2 cell_extent=output_size/grid_size*zoom;
  float2 p=(local-0.5)*cell_extent;
  float radius=min(cell_extent.x,cell_extent.y)*0.46*sqrt(idx/5.0);
  if(shape_mode>1.5){
   // Rasterize directly on actual output pixels. A virtual 16px mask sampled
   // into fractional-width cells gave each copy a different sampling phase.
   float2 circle_center=(((cell+0.5)/grid_size-center)*zoom+0.5)*output_size;
   float2 delta=frame_pixel-floor(circle_center+0.0001);
   float max_radius=max(0.0,floor((min(cell_extent.x,cell_extent.y)-2.0)/2.0));
   float circle_radius=floor(max_radius*sqrt(idx/5.0)+0.5);
   // Equal-area tone steps where resolution permits; reserve a distinct radius
   // for each remaining tone when a small cell has only five usable radii.
   if(max_radius>=5.0)circle_radius=min(max(circle_radius,idx),max_radius-5.0+idx);
   // Include edge pixel centres for a round silhouette without isolated poles.
   float disk_radius=circle_radius+(circle_radius>1.5?0.49:0.0);
   mask=idx<0.5?0.0:(dot(delta,delta)<=disk_radius*disk_radius?1.0:0.0);
  }else {
   float2 d=abs(p)-radius*0.886226925;
   float distance_to_edge=length(max(d,float2(0.0,0.0)))+min(max(d.x,d.y),0.0);
   // One output-pixel edge coverage; the square corners remain square.
   mask=idx<0.5?0.0:saturate(0.5-distance_to_edge);
  }
 }else {
  mask=atlas.Sample(point_sampler,float2((idx+local.x)/glyph_count,local.y)).r;
 }
 float alpha=transparent>0.5?mask:1.0;
 float3 rgb=transparent>0.5?foreground.rgb*mask:lerp(background.rgb,foreground.rgb,mask);
 return float4(rgb*src.a,alpha*src.a);
}
technique Downsample { pass { vertex_shader=VSDefault(v); pixel_shader=PSDownsample(v); } }
technique Quantize { pass { vertex_shader=VSDefault(v); pixel_shader=PSQuantize(v); } }
technique Draw { pass { vertex_shader=VSDefault(v); pixel_shader=PSDraw(v); } }
